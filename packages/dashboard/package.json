{
  "name": "@starktech/velo-dashboard",
  "version": "0.1.0",
  "description": "Web dashboard for velo time tracking (optional companion to @starktech/velo; needs @starktech/velo-api).",
  "keywords": [
    "velo",
    "starktech",
    "time",
    "tracking",
    "dashboard",
    "react"
  ],
  "license": "MIT",
  "author": "starktechlabs",
  "homepage": "https://github.com/starktechlabs/velo#readme",
  "bugs": {
    "url": "https://github.com/starktechlabs/velo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starktechlabs/velo.git",
    "directory": "packages/dashboard"
  },
  "type": "module",
  "bin": {
    "velo-dashboard": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node esbuild.config.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@starktech/core": "*",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "lucide-react": "^1.59.0",
    "react": "^19.1.0",
    "react-day-picker": "^9.9.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "recharts": "^3.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.7"
  }
}
