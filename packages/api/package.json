    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@starktech/core": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3"
  }
}
