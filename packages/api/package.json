{
  "name": "@starktech/velo-api",
  "version": "0.1.0",
  "description": "Local REST API for velo time tracking (optional companion to @starktech/velo).",
  "keywords": [
    "velo",
    "starktech",
    "time",
    "tracking",
    "api",
    "express",
    "sqlite"
  ],
  "license": "MIT",
  "author": "starktechlabs",
  "homepage": "https://github.com/starktechlabs/velo#readme",
  "bugs": {
    "url": "https://github.com/starktechlabs/velo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starktechlabs/velo.git",
    "directory": "packages/api"
  },
  "type": "module",
  "bin": {
    "velo-api": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@starktech/core": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  }
}
