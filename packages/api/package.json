{
  "name": "@starktech/velo-api",
  "description": "Local REST API for velo time tracking",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "bin": {
    "velo-api": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.js",
